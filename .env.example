# ==============================================================================
# TAXISCANNER BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Use this file as a template for local development (.env) and production deployment
# (e.g. Vercel Project Environment Variables).
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_NAME=TaxiScanner
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-taxiscanner-backend.vercel.app
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ------------------------------------------------------------------------------
# LOGGING (SERVERLESS RUNTIME OPTIMIZED)
# ------------------------------------------------------------------------------
# On Vercel, set LOG_CHANNEL=stderr to stream logs directly to Vercel runtime logs.
# For local / EC2 persistent servers, use LOG_CHANNEL=stack or single.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# DATABASE (STATIC REFERENCE SQLITE DATABASE)
# ------------------------------------------------------------------------------
# Bundled static/reference database containing taxi providers and pricing configs.
# Treated as read-only on Vercel.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Optional remote database configuration (for EC2 / external databases):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
# For serverless with read-only SQLite, use 'file' (writes to /tmp) or 'array'
# to avoid database write attempts on the static SQLite file.
CACHE_STORE=file
CACHE_PREFIX=taxiscanner_cache

# ------------------------------------------------------------------------------
# QUEUES / WORKERS
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# SESSIONS
# ------------------------------------------------------------------------------
# Stateless API: use 'array' or 'cookie' to avoid database session writes.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------------------
# CORS (FRONTEND INTEGRATION)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Matches your Vercel frontend and local development.
CORS_ALLOWED_ORIGINS=https://taxiscanner.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# FILE STORAGE & AWS S3 (OPTIONAL)
# ------------------------------------------------------------------------------
# Vercel filesystem is read-only at runtime (except /tmp). Use S3 for persistent assets.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# REDIS (OPTIONAL - UPSTASH / AWS ELASTICACHE)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_URL=

# ------------------------------------------------------------------------------
# MAIL (TRANSACTIONAL EMAILS)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@taxiscanner.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# TAXISCANNER CORE DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
TAXISCANNER_CURRENCY=GBP
TAXISCANNER_CACHE_PREFIX=taxiscanner
TAXISCANNER_GEOCODING_CACHE_TTL=1209600
TAXISCANNER_ROUTE_CACHE_TTL=604800
TAXISCANNER_ESTIMATE_CACHE_TTL=300
TAXISCANNER_ANALYTICS_ENABLED=false

# ------------------------------------------------------------------------------
# MAPPING & ROUTING PROVIDERS (MAPBOX)
# ------------------------------------------------------------------------------
TAXISCANNER_GEOCODING_PROVIDER=mapbox
TAXISCANNER_ROUTING_PROVIDER=mapbox
TAXISCANNER_MAP_API_KEY=
MAPBOX_ACCESS_TOKEN=
TAXISCANNER_MAP_TIMEOUT=5
TAXISCANNER_ALLOW_SIMULATED_FALLBACK=false
TAXISCANNER_GEOCODING_COUNTRY=gb
TAXISCANNER_POI_MAX_RADIUS_MILES=35.0
TAXISCANNER_POI_CONFIDENCE_THRESHOLD=0.60

# ------------------------------------------------------------------------------
# TAXI PROVIDER TOGGLES & CREDENTIALS
# ------------------------------------------------------------------------------
PROVIDER_UBER_ENABLED=true
PROVIDER_UBER_MODE=estimate
PROVIDER_UBER_CLIENT_ID=
PROVIDER_UBER_CLIENT_SECRET=

PROVIDER_BOLT_ENABLED=true
PROVIDER_BOLT_MODE=estimate
PROVIDER_BOLT_API_KEY=

PROVIDER_STREETCARS_ENABLED=true
PROVIDER_STREETCARS_MODE=estimate
PROVIDER_STREETCARS_API_KEY=
TAXISCANNER_STREETCARS_GEO_CALIBRATION_ENABLED=false

PROVIDER_VEEZU_ENABLED=true
PROVIDER_VEEZU_MODE=estimate
PROVIDER_VEEZU_API_KEY=
